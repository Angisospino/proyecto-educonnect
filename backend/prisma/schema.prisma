generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Rol {
  ADMINISTRADOR
  DOCENTE
  ESTUDIANTE
  PADRE_FAMILIA
  DIRECTIVO
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  TARDANZA
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nombre       String        @db.VarChar(100)
  apellido     String        @db.VarChar(100)
  email        String        @unique @db.VarChar(150)
  passwordHash String        @db.VarChar(255)
  rol          Rol
  estado       EstadoUsuario @default(ACTIVO)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relaciones
  estudiantePerfil EstudiantePerfil?
  notas             Nota[]
  asistencias       Asistencia[]
  hijos             PadreEstudiante[]
  comunicados       Comunicado[]
  notificaciones    Notificacion[]

  @@map("usuarios")
}

model Curso {
  id       Int    @id @default(autoincrement())
  nombre   String @db.VarChar(50)
  jornada  String? @db.VarChar(20)

  estudiantes EstudiantePerfil[]
  asistencias Asistencia[]
}

model Asignatura {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(80)

  notas Nota[]
}

model EstudiantePerfil {
  id              Int    @id @default(autoincrement())
  usuarioId       Int    @unique
  cursoId         Int
  codigoEstudiantil String @unique @db.VarChar(30)

  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  curso       Curso   @relation(fields: [cursoId], references: [id])
  notas       Nota[]
  asistencias Asistencia[]
  padres      PadreEstudiante[]
}

// Vinculo padre/madre de familia - estudiante (muchos a muchos):
// un padre puede tener varios hijos y un estudiante varios padres.
// estudianteId referencia a EstudiantePerfil.id (no a Usuario.id).
model PadreEstudiante {
  id           Int              @id @default(autoincrement())
  padreId      Int
  estudianteId Int

  padre      Usuario          @relation(fields: [padreId], references: [id])
  estudiante EstudiantePerfil @relation(fields: [estudianteId], references: [id])

  @@unique([padreId, estudianteId])
}

model Nota {
  id            Int      @id @default(autoincrement())
  estudianteId  Int
  asignaturaId  Int
  docenteId     Int
  periodo       String   @db.VarChar(10)
  valor         Decimal  @db.Decimal(3, 1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  estudiante EstudiantePerfil @relation(fields: [estudianteId], references: [id])
  asignatura Asignatura       @relation(fields: [asignaturaId], references: [id])
  docente    Usuario          @relation(fields: [docenteId], references: [id])
}

model Asistencia {
  id           Int              @id @default(autoincrement())
  estudianteId Int
  cursoId      Int
  docenteId    Int
  fecha        DateTime         @db.Date
  estado       EstadoAsistencia

  estudiante EstudiantePerfil @relation(fields: [estudianteId], references: [id])
  curso      Curso             @relation(fields: [cursoId], references: [id])
  docente    Usuario           @relation(fields: [docenteId], references: [id])

  @@unique([estudianteId, fecha])
  @@index([cursoId, fecha])
}

enum EstadoComunicado {
  PUBLICADO
  EDITADO
  ELIMINADO
}

model Comunicado {
  id               Int              @id @default(autoincrement())
  autorId          Int
  titulo           String           @db.VarChar(150)
  contenido        String           @db.Text
  fechaPublicacion DateTime         @default(now())
  estado           EstadoComunicado @default(PUBLICADO)

  autor          Usuario        @relation(fields: [autorId], references: [id])
  notificaciones Notificacion[]

  @@index([estado, fechaPublicacion])
}

enum CanalNotificacion {
  EMAIL
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDA
}

model Notificacion {
  id           Int                @id @default(autoincrement())
  usuarioId    Int
  comunicadoId Int?
  canal        CanalNotificacion  @default(EMAIL)
  estado       EstadoNotificacion @default(PENDIENTE)
  fechaEnvio   DateTime?

  usuario    Usuario     @relation(fields: [usuarioId], references: [id])
  comunicado Comunicado? @relation(fields: [comunicadoId], references: [id])

  @@index([estado])
  @@index([usuarioId])
}
